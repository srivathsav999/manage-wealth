pipeline {
    agent any

    environment {
        // Jenkins doesn't inherit the user's shell PATH, so we add it explicitly
        PATH = "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${env.PATH}"
    }

    triggers {
        // Poll SCM every 5 minutes for changes
        pollSCM('H/5 * * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir('selenum_demo') {
                    // Always run mvn clean test before sending to GitHub
                    sh 'mvn -Dmaven.test.failure.ignore=true -Dheadless=true clean test'
                }
            }
        }
    }

    post {
        always {
            // Publish TestNG results for dashboard
            junit testResults: 'selenum_demo/target/surefire-reports/*.xml', allowEmptyResults: true

            // TestNG Reports Analyzer (testNG plugin is installed)
            testNG(reportFilenamePattern: 'selenum_demo/target/surefire-reports/testng-results.xml',
                   showFailedBuilds: true)

            // Archive test results artifacts
            archiveArtifacts artifacts: 'selenum_demo/target/surefire-reports/**/*', allowEmptyArchive: true
        }

        success {
            echo 'Selenium tests passed successfully!'
        }

        failure {
            echo 'Selenium tests failed! Check the TestNG report for details.'
        }

        unstable {
            echo 'Selenium tests completed with some failures.'
        }
    }
}
